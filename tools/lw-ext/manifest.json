{
  "manifest_version": 3,
  "name": "Tokiwa Hub × LINE WORKS",
  "version": "1.0",
  "description": "Hub からノートに入れたあと、LINE WORKS のノートのカテゴリーを自動で付け替えます（移動 → カテゴリー → OK を代わりに押します）",
  "content_scripts": [
    { "matches": ["https://talk.worksmobile.com/*"], "js": ["lw.js"], "run_at": "document_start" },
    { "matches": ["https://tokiwa1928.github.io/tokiwa-hub-app/*", "http://localhost/*", "http://localhost:*/*"], "js": ["hub.js"], "run_at": "document_start" }
  ]
}
