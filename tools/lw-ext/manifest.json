{
  "manifest_version": 3,
  "name": "Tokiwa Hub × LINE WORKS",
  "version": "1.5",
  "description": "Hub からノートに入れたあと、LINE WORKS のノートのカテゴリーを自動で付け替えます。また、LINE WORKS を開いているあいだ、ノートのカテゴリーを読んで Hub（校正BOX の状態）に送ります",
  "content_scripts": [
    {
      "matches": [
        "https://talk.worksmobile.com/*"
      ],
      "js": [
        "lw.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://tokiwa1928.github.io/tokiwa-hub-app/*",
        "http://localhost/*",
        "http://localhost:*/*"
      ],
      "js": [
        "hub.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lwhook.js"
      ],
      "matches": [
        "https://talk.worksmobile.com/*"
      ]
    }
  ]
}